rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/state {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    match /users/{uid}/data/learning/operations/{opId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read: if owner();
      allow create: if owner()
        && opId.matches('k-[a-f0-9]{32}')
        && request.resource.data.keys().hasAll(['kind', 'target', 'value', 'clock'])
        && request.resource.data.keys().hasOnly(['kind', 'target', 'value', 'clock', 'day'])
        && (!('day' in request.resource.data)
            || (request.resource.data.kind in ['answer', 'today-answer']
                && request.resource.data.day is string
                && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && request.resource.data.kind in ['point', 'delete', 'subject', 'chapter', 'move', 'baseline', 'answer', 'today-round', 'today-answer', 'paper', 'paper-question', 'paper-subject', 'exam-draft', 'exam-submit']
        && (!(request.resource.data.kind in ['exam-draft', 'exam-submit'])
            || (request.resource.data.target.matches('k-[a-f0-9]{32}')
                && request.resource.data.value is map
                && request.resource.data.value.paperResultId == request.resource.data.target
                && (request.resource.data.kind == 'exam-submit' ? opId == request.resource.data.target : opId != request.resource.data.target)))
        && request.resource.data.target is string
        && request.resource.data.clock is int
        && request.resource.data.clock >= 0;
      allow update: if owner() && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
