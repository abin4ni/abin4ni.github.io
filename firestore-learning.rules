// Merge inside the existing match /databases/{database}/documents block.
// Keep the existing course rules and review broader wildcard grants.
match /users/{uid}/data/learning/operations/{opId} {
  function owner() {
    return request.auth != null && request.auth.uid == uid;
  }
  function validTodayTask(opId) {
    let record = request.resource.data;
    let task = record.value;
    return record.target is string
      && record.target.matches('k-[a-f0-9]{32}')
      && task is map
      && task.keys().hasAll(['type', 'action', 'at'])
      && task.type in ['daily', 'todo']
      && task.at is int && task.at >= 0 && task.at <= 9007199254740991
      && (task.action == 'create' ? opId == record.target : opId != record.target)
      && (
        (task.action in ['create', 'edit']
          && task.keys().hasOnly(['type', 'action', 'at', 'text'])
          && task.text is string && task.text.size() > 0 && task.text.size() <= 160)
        || (task.action == 'delete' && task.keys().hasOnly(['type', 'action', 'at']))
        || (task.action in ['check', 'uncheck'] && (
          (task.type == 'daily' && task.keys().hasOnly(['type', 'action', 'at', 'date'])
            && task.date is string && task.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          || (task.type == 'todo' && task.keys().hasOnly(['type', 'action', 'at']))
        ))
      );
  }
  allow read: if owner();
  allow create: if owner()
    && opId.matches('k-[a-f0-9]{32}')
    && request.resource.data.keys().hasAll(['kind', 'target', 'value', 'clock'])
    && request.resource.data.keys().hasOnly(['kind', 'target', 'value', 'clock', 'day'])
    && (!('day' in request.resource.data)
        || (request.resource.data.kind in ['answer', 'today-answer']
            && request.resource.data.day is string
            && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
    && request.resource.data.kind in ['point', 'delete', 'subject', 'chapter', 'move', 'baseline', 'answer', 'today-round', 'today-answer', 'paper', 'paper-question', 'paper-subject', 'exam-draft', 'exam-submit', 'today-task']
    && (request.resource.data.kind != 'today-task' || validTodayTask(opId))
    && (!(request.resource.data.kind in ['exam-draft', 'exam-submit'])
        || (request.resource.data.target.matches('k-[a-f0-9]{32}')
            && request.resource.data.value is map
            && request.resource.data.value.paperResultId == request.resource.data.target
            && (request.resource.data.kind == 'exam-submit' ? opId == request.resource.data.target : opId != request.resource.data.target)))
    && request.resource.data.target is string
    && request.resource.data.clock is int
    && request.resource.data.clock >= 0;
  allow update: if owner() && request.resource.data == resource.data;
  allow delete: if false;
}
